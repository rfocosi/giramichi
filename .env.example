# ================================================
# Giramichi (煌道) Environment Configuration
# ================================================

# Server Port
PORT=3001

# ------------------------------------------------
# Authentication Configuration: disabled | oauth2
# ------------------------------------------------
AUTH_MODE=disabled # disabled | oauth2
OAUTH2_ISSUER=http://localhost:8080/realms/giramichi
OAUTH2_JWKS_URI=http://localhost:8080/realms/giramichi/protocol/openid-connect/certs
OAUTH2_CLIENT_ID=giramichi-agent
# OAUTH2_AUDIENCE=account

# Database Backend Type: sqlite | postgres | mysql | mssql
DB_TYPE=sqlite

# ------------------------------------------------
# Option A: SQLite Configuration (Default)
# ------------------------------------------------
DB_DIR=data
DB_FILE=giramichi.db

# ------------------------------------------------
# Option B: PostgreSQL Configuration
# ------------------------------------------------
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=giramichi
# DB_SSL=false
# Or use connection string:
# DATABASE_URL=postgres://user:password@localhost:5432/giramichi

# ------------------------------------------------
# Option C: MySQL / MariaDB Configuration
# ------------------------------------------------
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=mysqlpassword
# DB_NAME=giramichi
# Or use connection string:
# DATABASE_URL=mysql://root:password@localhost:3306/giramichi

# ------------------------------------------------
# Option D: Microsoft SQL Server Configuration
# ------------------------------------------------
# DB_TYPE=mssql
# DB_HOST=localhost
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=YourPassword123!
# DB_NAME=giramichi
# DB_ENCRYPT=false
# Or use connection string:
# DATABASE_URL=mssql://sa:YourPassword123!@localhost:1433/giramichi

# ------------------------------------------------
# Redis Configuration (For Multi-Instance MCP SSE)
# ------------------------------------------------
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
