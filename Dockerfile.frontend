# ==========================================
# Phase 1: Build Phase (Vite SPA Compilation)
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies for C++ native modules (better-sqlite3)
RUN apk add --no-cache python3 make g++ gcc

# Copy package manifests and install dependencies
COPY package*.json ./
RUN npm ci

# Copy source code and build React 19 frontend
COPY . .
RUN npm run build

# ==========================================
# Phase 2: Nginx Web Server Runtime
# ==========================================
FROM nginx:alpine AS runner

# Copy compiled frontend assets from build stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Entrypoint script to dynamically generate config.js from GIRAMICHI_API_URL at container startup
COPY scripts/generate-frontend-config.sh /docker-entrypoint.d/40-generate-config.sh
RUN chmod +x /docker-entrypoint.d/40-generate-config.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
