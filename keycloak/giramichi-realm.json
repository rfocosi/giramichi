{
  "realm": "giramichi",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "giramichi-agent",
      "name": "Giramichi AI Agent CLI",
      "description": "Client for AI Agents connecting to Giramichi using Device Authorization Flow",
      "rootUrl": "",
      "baseUrl": "",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "post.logout.redirect.uris": "*"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "agent-dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Agent",
      "email": "agent-dev@giramichi.local",
      "credentials": [
        {
          "type": "password",
          "value": "agent123",
          "temporary": false
        }
      ]
    },
    {
      "username": "agent-claude",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Claude",
      "lastName": "Agent",
      "email": "agent-claude@giramichi.local",
      "credentials": [
        {
          "type": "password",
          "value": "agent123",
          "temporary": false
        }
      ]
    }
  ]
}
